<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!--
      The encrypted preference files are tied to a Keystore key that is NOT part of
      any backup. Restoring them onto a fresh install / new phone leaves ciphertext
      nobody can decrypt, so they are excluded (together with their keyset file).
    -->

    <cloud-backup>
        <include domain="database" path="nsa.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="security_prefs.xml" />
        <exclude domain="sharedpref" path="car_prefs.xml" />
        <exclude domain="sharedpref" path="notification_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="nsa.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="security_prefs.xml" />
        <exclude domain="sharedpref" path="car_prefs.xml" />
        <exclude domain="sharedpref" path="notification_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>

</data-extraction-rules>
